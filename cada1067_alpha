#!/bin/bash
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -f "$DIR/cad_env/bin/activate" ]]; then
    source "$DIR/cad_env/bin/activate"
fi

export PATH="$DIR:$PATH"
if [[ -d "$DIR/cad_env/lib" ]]; then
    export LD_LIBRARY_PATH="$DIR/cad_env/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
if [[ -x "$DIR/yosys" ]]; then
    export YOSYS_BIN="$DIR/yosys"
fi

cd "$DIR"

exec python "$DIR/main.py" "$@"
